# Example: Certificate - Basic

resource "f5xc_certificate" "example" {
  name        = "example-certificate"
  namespace   = "default"
  description = "Certificate example"

  certificate_url = "string:"

  private_key = {
    secret_info_choice = {
      clear_secret_info = {
        url = "string:"
      }
    }
  }
}
